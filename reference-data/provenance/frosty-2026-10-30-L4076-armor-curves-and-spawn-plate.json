  "leads": [
   {
    "id": "L4076",
    "title": "Armor plates on 2.1.1.0: ArmorGrantSpawnPlate feeds a Battle Royale plate grant, multiplayer spawn armor defaults to none; BTK effect of the 13 changed armor curves",
    "status": "finding",
    "summary": "The new GRX_Glacier_Soldier row ArmorGrantSpawnPlate (true) is read only by SimEx_Ability_ArmorGrant, whose graph grants the Granite loot item Ammo_Armor; Ability_ArmorGrant was granted only by a Battle Royale field-upgrade path, no captured 2.1.1.0 multiplayer asset grants it, and the multiplayer spawn-armor mutator SpawnWithArmor defaults to 0, so plates are REDSEC/Gauntlet content; against a plate the 13 changed armor curves add up to two shots (candidate capacity 40/80, no spill) and unplated BTK is unchanged.",
    "reopenWhen": "A multiplayer HUD armor bar in a standard mode, a capture of Ability_ArmorGrant and the FieldUpgradePath_BR_*_Y2 paths, or a mode override of SpawnWithArmor."
   }
  ],
