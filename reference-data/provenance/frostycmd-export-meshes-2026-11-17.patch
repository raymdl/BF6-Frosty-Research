+        // Positions and triangles of the first LOD's renderable sections as OBJ (one object per section),
+        // following the editor's FBX exporter layout: streams follow each other from VertexOffset, indices
+        // start at VertexBufferSize. Returns a one-line summary.
+        private static string WriteObj(AssetManager assetManager, MeshSetPlugin.Resources.MeshSet meshSet, string target)
+        {
+            MeshSetPlugin.Resources.MeshSetLod lod = meshSet.Lods[0];
+            byte[] data;
+            using (Stream chunk = lod.ChunkId != Guid.Empty ? assetManager.GetChunk(assetManager.GetChunkEntry(lod.ChunkId)) : new MemoryStream(lod.InlineData))
+            using (MemoryStream copy = new MemoryStream())
+            {
+                chunk.CopyTo(copy);
+                data = copy.ToArray();
+            }
+            int indexSize = lod.IndexUnitSize / 8;
+            List<string> summary = new List<string>();
+            int baseIndex = 1;
+            using (StreamWriter obj = new StreamWriter(target, false))
+            {
+                obj.WriteLine("# " + meshSet.Name + " lod " + lod.Name + " lods=" + meshSet.Lods.Count + " chunkBytes=" + data.Length);
+                foreach (MeshSetPlugin.Resources.MeshSetSection section in lod.Sections)
+                {
+                    if (!lod.IsSectionRenderable(section) || section.PrimitiveCount == 0) continue;
+                    GeometryDeclarationDesc decl = section.GeometryDeclDesc[0];
+                    long streamBase = section.VertexOffset;
+                    long posStart = -1; int posStride = 0; VertexElementFormat posFormat = VertexElementFormat.None; int posOffset = 0;
+                    for (int j = 0; j < decl.Streams.Length; j++)
+                    {
+                        int stride = decl.Streams[j].VertexStride;
+                        if (stride == 0) continue;
+                        foreach (GeometryDeclarationDesc.Element elem in decl.Elements)
+                        {
+                            if (elem.StreamIndex == j && elem.Usage == VertexElementUsage.Pos && posStart < 0)
+                            {
+                                posStart = streamBase; posStride = stride; posFormat = elem.Format; posOffset = elem.Offset;
+                            }
+                        }
+                        streamBase += (long)stride * section.VertexCount;
+                    }
+                    if (posStart < 0) throw new InvalidDataException("Section " + section.Name + " has no position element");
+
+                    obj.WriteLine("o " + section.Name);
+                    for (int i = 0; i < section.VertexCount; i++)
+                    {
+                        long at = posStart + (long)i * posStride + posOffset;
+                        float x, y, z;
+                        if (posFormat == VertexElementFormat.Float3 || posFormat == VertexElementFormat.Float4)
+                        {
+                            x = BitConverter.ToSingle(data, (int)at); y = BitConverter.ToSingle(data, (int)at + 4); z = BitConverter.ToSingle(data, (int)at + 8);
+                        }
+                        else if (posFormat == VertexElementFormat.Half3 || posFormat == VertexElementFormat.Half4)
+                        {
+                            x = Half(data, at); y = Half(data, at + 2); z = Half(data, at + 4);
+                        }
+                        else throw new InvalidDataException("Unsupported position format " + posFormat);
+                        obj.WriteLine(string.Format(System.Globalization.CultureInfo.InvariantCulture, "v {0} {1} {2}", x, y, z));
+                    }
+                    long indexAt = lod.VertexBufferSize + (long)section.StartIndex * indexSize;
+                    for (int i = 0; i < section.PrimitiveCount; i++)
+                    {
+                        long[] tri = new long[3];
+                        for (int k = 0; k < 3; k++, indexAt += indexSize)
+                        {
+                            tri[k] = indexSize == 2 ? BitConverter.ToUInt16(data, (int)indexAt) : BitConverter.ToUInt32(data, (int)indexAt);
+                            if (tri[k] >= section.VertexCount) throw new InvalidDataException("Index " + tri[k] + " out of range in section " + section.Name);
+                        }
+                        obj.WriteLine("f " + (tri[0] + baseIndex) + " " + (tri[1] + baseIndex) + " " + (tri[2] + baseIndex));
+                    }
+                    baseIndex += (int)section.VertexCount;
+                    summary.Add(section.Name + ":" + section.VertexCount + "v/" + section.PrimitiveCount + "t/" + posFormat);
+                }
+            }
+            return string.Join(" ", summary);
+        }
+
+        private static float Half(byte[] data, long at)
+        {
+            int h = BitConverter.ToUInt16(data, (int)at);
+            int sign = (h >> 15) & 1, exp = (h >> 10) & 0x1f, mant = h & 0x3ff;
+            float value = exp == 0 ? mant / 1024f * (float)Math.Pow(2, -14)
+                : exp == 31 ? float.NaN
+                : (1 + mant / 1024f) * (float)Math.Pow(2, exp - 15);
+            return sign == 1 ? -value : value;
+        }
